{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker の名前。テンプレートから作ったら、サイトの名前に変える（workers.dev の URL にもなる）
  "name": "web-site",
  // デプロイするアカウント。ログインしているユーザーが複数のアカウントに入れるときは、ID を書いて固定する
  // "account_id": "",
  "compatibility_date": "2026-10-28",
  // astro build の静的出力をそのまま配る。サーバーの処理は無い
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // 独自ドメインで公開するときは、Cloudflare で DNS を管理しているドメインを足す。
  // デプロイすると DNS のレコードと証明書が自動でできる。ドメインを付けると workers.dev の URL は既定で止まるので、
  // 残すなら "workers_dev": true も足す。astro.config.ts の site も同じドメインにする
  // "routes": [{ "pattern": "www.example.com", "custom_domain": true }],
  // PR のブランチごとのプレビュー（Cloudflare の Git 連携が npx wrangler preview で出す）。
  // このブロックが無いと preview が止まる。中身は上の設定をそのまま使うので空でよい
  "previews": {},
}
