{
  "name": "site",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "gen": "panda codegen",
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "lint": "pnpm run \"/^lint:/\"",
    "lint:astro": "astro check",
    "lint:oxlint": "oxlint .",
    "fmt": "pnpm run \"/^fmt:/\"",
    "fmt:oxfmt": "oxfmt --write .",
    "fmt:prettier": "prettier --write \"**/*.astro\""
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@pandacss/dev": "2.4.0",
    "@pandacss/preset-base": "2.4.0",
    "@pandacss/vite": "2.4.0",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "wrangler": "4.151.1"
  }
}
